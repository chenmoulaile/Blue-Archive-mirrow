# 依赖
node_modules/
dist/
out/
release/

# 素材不入库（7.1GB，随 GitHub Release 分卷包分发，每包 ≤1.9GB）
resources/
viewer/
# data/ 元数据按 2026-11-09 新政策解除 ignore 入库：git clone 后补素材包即可跑
# （此前仅 ui_atlas/ui_nineslice/se_index/se_map/bgm_map 五个白名单入库）

# 本地存档与缓存
*.db
*.sqlite
*.sqlite3
.cache/

# 本地备份文件（改动前 checkpoint 备份，不入库）
*.bak-*
data/*.bak-*

# 系统
.DS_Store
Thumbs.db
*.log
.part

# Electron 运行时数据（存档/缓存），全部落在工作目录
.userdata/
.npmrc

# 本地临时目录（TEMP/TMP 统一指到这里，避免写 C 盘）
.tmp/

# 外部工具与解包工作区（体积大，不入库）
.vendor/
.baad/
__pycache__/
