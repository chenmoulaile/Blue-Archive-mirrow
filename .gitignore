# 依赖
node_modules/
dist/
out/
release/

# 素材与抓取结果（体积大、版权归原厂，不入库）
resources/
viewer/
data/*.json
# 例外：解包出来的元数据体积小、重建成本高，入库方便下一个 agent 接手
!data/ui_atlas.json
!data/ui_nineslice.json
!data/se_index.json
!data/se_map.json
!data/bgm_map.json

# 本地存档与缓存
*.db
*.sqlite
*.sqlite3
.cache/

# 系统
.DS_Store
Thumbs.db
*.log
.part

# Electron 运行时数据（存档/缓存），全部落在工作目录
.userdata/
.npmrc

# 本地临时目录（TEMP/TMP 统一指到这里，避免写 C 盘）
.tmp/

# 外部工具与解包工作区（体积大，不入库）
.vendor/
.baad/
__pycache__/
